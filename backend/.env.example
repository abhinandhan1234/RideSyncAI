PORT=5002
HOST=0.0.0.0
# Atlas or a local replica set (MongoDB 7+); never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/ridesync_booking?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
AI_ENGINE_URL=http://127.0.0.1:8000
AI_REQUEST_TIMEOUT_MS=1500
MAX_ASSIGNMENT_ATTEMPTS=4
OFFER_TIMEOUT_SECONDS=20
OFFER_WORKER_INTERVAL_MS=1000
MAX_PICKUP_KM=12

# Generate a random secret for persistent authenticated sessions.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
# Explicit opt-in for unauthenticated, isolated demo API (/api/demo).
ENABLE_BOOKING_DEMO=false

# Cashfree DigiLocker is simulated by default. Live verification is not enabled
# until Cashfree provides credentials and the callback flow is configured.
DIGILOCKER_MODE=demo
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
